<root-portal wx:if="{{open}}"><view class="person-layer" catchtouchmove="noop"><view class="person-mask" catchtap="close"></view><view class="person-sheet" catchtap="noop">
  <view class="person-heading"><text class="person-title">{{title}}</text><button class="person-cancel" size="mini" bindtap="close">取消</button></view>
  <view class="person-team-heading">先选团队，再选择成员</view>
  <scroll-view scroll-x class="person-teams"><view class="person-team-list"><button size="mini" class="person-team {{!teamId?'person-team-active':''}}" data-id="" bindtap="chooseTeam">全部团队</button><button wx:for="{{teamRows}}" wx:key="id" size="mini" class="person-team {{teamId===item.id?'person-team-active':''}}" data-id="{{item.id}}" bindtap="chooseTeam">{{item.name}}</button></view></scroll-view>
  <input class="person-search" value="{{query}}" placeholder="搜索姓名、账号或团队" maxlength="100" bindinput="search"/>
  <scroll-view wx:if="{{selectedRows.length}}" scroll-x class="person-selected"><view class="person-selected-list"><text class="person-selected-title">已选 {{draft.length}} 人</text><view wx:for="{{selectedRows}}" wx:key="id" class="person-selected-chip"><text>{{item.name}}</text><label wx:if="{{item.account_code}}" class="person-selected-account">{{item.account_code}}</label></view></view></scroll-view>
  <scroll-view scroll-y class="person-rows">
    <view wx:if="{{loading}}" class="person-state">正在加载人员…</view>
    <view wx:elif="{{error}}" class="person-state person-error" bindtap="retry">{{error}} · 点击重试</view>
    <block wx:else>
      <button wx:if="{{allowAll}}" class="person-row {{!draft.length?'person-row-active':''}}" bindtap="chooseAll"><view class="person-copy"><text class="person-name">{{allLabel}}</text><label class="person-meta">全部授权成员，不受当前团队和搜索限制</label></view><text class="person-check">{{!draft.length?'✓':''}}</text></button>
      <button wx:for="{{rows}}" wx:key="id" class="person-row {{item.checked?'person-row-active':''}}" data-id="{{item.id}}" bindtap="toggle"><view class="person-avatar">{{item.initial || '人'}}</view><view class="person-copy"><text class="person-name">{{item.name}}</text><label class="person-meta">{{item.account_code || '未标注账号'}} · {{item.teamLabel || '未分组'}}</label></view><text class="person-check {{multiple?'person-check-multiple':''}}">{{item.checked?'✓':''}}</text></button>
      <view wx:if="{{!rows.length}}" class="person-state">没有匹配的成员，请调整团队或关键词</view>
    </block>
  </scroll-view>
  <view class="person-footer"><text class="person-note {{selectionError?'person-error':''}}">{{selectionError || (multiple?'切换团队或搜索会保留已选人员':'确认后应用所选成员')}}</text><button class="person-confirm {{!canConfirm?'person-confirm-disabled':''}}" disabled="{{!canConfirm}}" bindtap="confirm">确认{{multiple && draft.length?'（'+draft.length+'人）':''}}</button></view>
</view></view></root-portal>
