<view class="scope-toolbar"><view class="role-scope-switch"><button wx:for="{{modes}}" wx:key="value" size="mini" class="role-scope-option {{mode===item.value?'role-scope-selected':''}}" data-mode="{{item.value}}" bindtap="switchMode">{{item.label}}</button></view><button wx:if="{{mode==='person' || (mode==='team' && teams.length>1)}}" size="mini" class="subject-trigger" bindtap="show">{{mode==='person'?'选择成员':'选择团队'}}<text>⌄</text></button></view><view class="subject-caption">{{label}}</view>
<person-picker id="personPicker" open="{{open && selecting==='person'}}" members="{{members}}" teams="{{teams}}" default-team-id="{{defaultTeamId}}" selected="{{personSelected}}" loading="{{loading}}" error="{{error}}" bind:confirm="confirmPerson" bind:close="close" bind:retry="retry"/>
<view wx:if="{{open && selecting==='team'}}" class="selector-mask" catchtap="close" catchtouchmove="noop"><view class="selector-sheet" catchtap="noop"><view class="selector-grip" bindtap="close"><view class="selector-grip-line"></view></view><view class="selector-heading">选择团队</view>
<scroll-view scroll-y class="selector-rows"><button wx:for="{{teams}}" wx:key="id" class="subject-row {{teamId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="select"><view class="subject-avatar">团</view><view class="subject-copy"><text class="subject-name">{{item.name}}</text></view><text class="subject-check">{{teamId===item.id?'✓':''}}</text></button></scroll-view><view class="selector-bottom">仅显示当前账号可查看的对象</view></view></view>
