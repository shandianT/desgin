{
  "$meta": {
    "name": "上游组件库主题桥接映射",
    "status": "建议：映射关系来自 2026-09-19 对官方仓库源码与 npm 发布包的查证（依据 08～12），未在真机与真实工程验证；上游版本升级后需重跑校验",
    "howItWorks": "每个库一段：map 里「上游变量名 → 值」。值写法：{ui.名字} 生成 var(--ui-名字)（CSS／WXSS）或已解析的字面值（JSON）；{ui.名字|rgb} 生成 r,g,b 三元组；{palette.primary.N} 取主色派生十档（N=1 最浅，6 为主色本身，10 最深；算法见 palette.mjs）。桥接文件必须在 design-tokens.css／.wxss 之后引入。",
    "principle": "不 fork、不改上游源码、不写第二套变量名；只改颜色、字号、圆角、控件高度、间距，组件结构与交互保持上游默认"
  },
  "tdesign": {
    "library": "tdesign-miniprogram 1.16.1（小程序）／tdesign-react 1.18.3、tdesign-vue-next 1.20.8（Web）；变量名三端同名",
    "outputs": {
      "wxss": {
        "file": "bridge-tdesign.wxss",
        "selector": "page",
        "platform": "miniprogram",
        "include": "app.wxss 头两行：@import \"./design-tokens.wxss\"; @import \"./bridge-tdesign.wxss\";"
      },
      "css": {
        "file": "bridge-tdesign.css",
        "selector": ":root",
        "platform": "web",
        "include": "在 design-tokens.css 之后引入"
      }
    },
    "map": {
      "--td-brand-color": "{ui.primary}",
      "--td-brand-color-1": "{palette.primary.1}",
      "--td-brand-color-2": "{palette.primary.1}",
      "--td-brand-color-3": "{palette.primary.2}",
      "--td-brand-color-4": "{palette.primary.3}",
      "--td-brand-color-5": "{palette.primary.4}",
      "--td-brand-color-6": "{palette.primary.5}",
      "--td-brand-color-7": "{palette.primary.6}",
      "--td-brand-color-8": "{palette.primary.7}",
      "--td-brand-color-9": "{palette.primary.8}",
      "--td-brand-color-10": "{palette.primary.9}",
      "--td-brand-color-active": "{ui.primary-hover}",
      "--td-brand-color-hover": "{ui.primary-hover}",
      "--td-brand-color-light": "{ui.selected}",
      "--td-error-color": "{ui.danger}",
      "--td-error-color-light": "{ui.danger-soft}",
      "--td-error-color-1": "{ui.danger-soft}",
      "--td-warning-color": "{ui.warning}",
      "--td-warning-color-light": "{ui.warning-soft}",
      "--td-warning-color-1": "{ui.warning-soft}",
      "--td-success-color": "{ui.success}",
      "--td-success-color-light": "{ui.success-soft}",
      "--td-success-color-1": "{ui.success-soft}",
      "--td-text-color-primary": "{ui.ink}",
      "--td-text-color-secondary": "{ui.secondary}",
      "--td-text-color-placeholder": "{ui.muted}",
      "--td-text-color-anti": "{ui.on-primary}",
      "--td-bg-color-page": "{ui.background}",
      "--td-bg-color-container": "{ui.surface}",
      "--td-bg-color-secondarycontainer": "{ui.neutral-soft}",
      "--td-border-level-1-color": "{ui.line}",
      "--td-border-level-2-color": "{ui.line}",
      "--td-component-stroke": "{ui.line}",
      "--td-component-border": "{ui.line}",
      "--td-font-family": "{ui.font}",
      "--td-font-family-medium": "{ui.font}",
      "--td-font-size-body-small": "{ui.text-small}",
      "--td-font-size-body-medium": "{ui.text-body}",
      "--td-font-size-base": "{ui.text-body}",
      "--td-font-size-title-medium": "{ui.text-section}",
      "--td-font-size-headline-small": "{ui.text-page}",
      "--td-spacer": "{ui.space-2}",
      "--td-spacer-1": "{ui.space-3}",
      "--td-spacer-2": "{ui.space-4}",
      "--td-spacer-3": "{ui.space-6}",
      "--td-spacer-4": "{ui.space-8}",
      "--td-radius-default": "{ui.radius-control}",
      "--td-radius-extraLarge": "{ui.radius-panel}",
      "--td-shadow-2": "{ui.shadow-popup}",
      "--td-overlay-bg-color": "{ui.overlay}",
      "--td-button-border-radius": "{ui.radius-control}",
      "--td-dialog-border-radius": "{ui.radius-panel}",
      "--td-popup-border-radius": "{ui.radius-panel}",
      "--td-input-error-tips-color": "{ui.danger}",
      "--td-input-border-color": "{ui.line}",
      "--td-tag-default-font-color": "{ui.neutral}",
      "--td-tag-default-light-color": "{ui.neutral-soft}",
      "--td-loading-color": "{ui.primary}",
      "--td-empty-description-color": "{ui.muted}",
      "--td-skeleton-bg-color": "{ui.neutral-soft}",
      "--td-dropdown-menu-active-color": "{ui.primary}",
      "--td-picker-confirm-color": "{ui.primary}",
      "--td-table-border-color": "{ui.line}",
      "--td-button-primary-disabled-bg": "{ui.neutral-soft}",
      "--td-button-primary-disabled-border-color": "{ui.neutral-soft}",
      "--td-button-primary-disabled-color": "{ui.muted}",
      "--td-button-primary-text-disabled-color": "{ui.muted}",
      "--td-button-default-outline-disabled-color": "{ui.muted}",
      "--td-button-primary-outline-disabled-color": "{ui.muted}",
      "--td-font-size-s": "{ui.text-small}",
      "--td-font-size-m": "{ui.text-body}",
      "--td-font-size-xl": "20px",
      "--td-font-body-small": "var(--ui-text-small) / 20px var(--ui-font)",
      "--td-font-body-medium": "14px / 22px var(--ui-font)",
      "--td-font-body-large": "var(--ui-text-body) / 24px var(--ui-font)",
      "--td-font-body-extra": "18px / 28px var(--ui-font)",
      "--td-font-title-small": "600 14px / 22px var(--ui-font)",
      "--td-font-title-medium": "600 var(--ui-text-body) / 24px var(--ui-font)",
      "--td-font-title-large": "600 18px / 26px var(--ui-font)",
      "--td-font-title-extra": "600 20px / 28px var(--ui-font)",
      "--td-font-mark-small": "600 var(--ui-text-small) / 20px var(--ui-font)",
      "--td-font-mark-medium": "600 14px / 22px var(--ui-font)",
      "--td-font-mark-large": "600 var(--ui-text-body) / 24px var(--ui-font)",
      "--td-font-headline-small": "600 24px / 32px var(--ui-font)",
      "--td-font-headline-medium": "600 28px / 36px var(--ui-font)",
      "--td-font-headline-large": "600 36px / 44px var(--ui-font)",
      "--td-button-large-height": "48px",
      "--td-button-medium-height": "{ui.touch-target}",
      "--td-button-small-height": "32px",
      "--td-button-extra-small-height": "28px",
      "--td-search-height": "{ui.field-height}"
    },
    "notes": {
      "--td-brand-color-7": "TDesign 的 --td-brand-color 指向第 7 档，所以十档整体下移一档让第 7 档等于主色；light／focus／disabled／active 分别取第 1／1／3／8 档",
      "--td-text-color-placeholder": "会同时改深输入框占位文字（比默认 .4 透明深），对比度更好，需设计确认（细项 D-11）",
      "--td-overlay-bg-color": "只覆盖 t-overlay；未覆盖 --td-mask-active，因为它同时是 t-toast 底色（细项 D-11）",
      "--td-font-size-body-medium": "TDesign 小程序默认单位 rpx（28rpx），这里按 X-09 写 px；真机核对 14px 与 28rpx 观感（细项 D-7）",
      "--td-spacer": "小程序端只部分组件消费 spacer；Web 端另有 --td-comp-margin-*，本轮未映射",
      "unmapped": "--ui-focus、--ui-control-height、--ui-field-height、--ui-touch-target、--ui-nav-*、--ui-list-width、--ui-tabbar-height、--ui-sidebar-*、--ui-page-gutter、--ui-block-gap、--ui-text-metric、--ui-space-1：TDesign 无同义变量，页面样式直接用 --ui-*",
      "--td-font-body-large": "TDesign 小程序的组合字体变量（字号 / 行高 字体族）默认写 rpx，320 宽屏上 32rpx 只有 13.7px，低于正文 16px；这里整套改写成 px（2026-09-23 小程序 1.0.8 第三轮复核），和 --td-font-size-* 同理",
      "--td-button-large-height": "TDesign 小程序按钮高度默认 rpx（大 96rpx、中 80rpx、小 64rpx），320 宽屏上底部条主按钮只有 41px；改成 px：大 48、中 44（点击底线）、小 32、超小 28（小号按钮由组件用伪元素扩到 44px 点击区）",
      "--td-search-height": "t-search 输入框默认 80rpx（320 宽 34px），跟表单控件同高"
    }
  },
  "semi": {
    "library": "@douyinfe/semi-ui 2.103.0（React；与飞书同源）",
    "outputs": {
      "css": {
        "file": "bridge-semi.css",
        "selector": "body, body .semi-always-light, :host, :host .semi-always-light",
        "platform": "web",
        "include": "在 semi.min.css 与 design-tokens.css 之后引入；深色模式本期不纳入（细项 D-10）"
      }
    },
    "map": {
      "--semi-blue-0": "{palette.primary.1|rgb}",
      "--semi-blue-1": "{palette.primary.2|rgb}",
      "--semi-blue-2": "{palette.primary.3|rgb}",
      "--semi-blue-3": "{palette.primary.4|rgb}",
      "--semi-blue-4": "{palette.primary.5|rgb}",
      "--semi-blue-5": "{palette.primary.6|rgb}",
      "--semi-blue-6": "{palette.primary.7|rgb}",
      "--semi-blue-7": "{palette.primary.8|rgb}",
      "--semi-blue-8": "{palette.primary.9|rgb}",
      "--semi-blue-9": "{palette.primary.10|rgb}",
      "--semi-color-primary": "{ui.primary}",
      "--semi-color-primary-hover": "{ui.primary-hover}",
      "--semi-color-primary-light-default": "{ui.selected}",
      "--semi-color-focus-border": "{ui.focus}",
      "--semi-color-bg-0": "{ui.background}",
      "--semi-color-bg-1": "{ui.surface}",
      "--semi-color-bg-2": "{ui.surface}",
      "--semi-color-bg-3": "{ui.surface}",
      "--semi-color-nav-bg": "{ui.sidebar}",
      "--semi-color-text-0": "{ui.ink}",
      "--semi-color-text-1": "{ui.secondary}",
      "--semi-color-text-2": "{ui.muted}",
      "--semi-color-border": "{ui.line}",
      "--semi-color-fill-0": "{ui.neutral-soft}",
      "--semi-color-danger": "{ui.danger}",
      "--semi-color-danger-light-default": "{ui.danger-soft}",
      "--semi-color-warning": "{ui.warning}",
      "--semi-color-warning-light-default": "{ui.warning-soft}",
      "--semi-color-success": "{ui.success}",
      "--semi-color-success-light-default": "{ui.success-soft}",
      "--semi-white": "{ui.on-primary|rgb}",
      "--semi-border-radius-medium": "{ui.radius-control}",
      "--semi-border-radius-large": "{ui.radius-panel}",
      "--semi-shadow-elevated": "{ui.shadow-popup}",
      "--semi-color-overlay-bg": "{ui.overlay}"
    },
    "notes": {
      "--semi-blue-5": "Semi 的 --semi-color-primary 定义为 rgba(var(--semi-blue-5),1)，link／focus／primary-light 引用第 0／5／6／7 档，所以必须覆盖十档三元组而不只是 primary",
      "--semi-color-fill-0": "同时是表格行悬停底与中性填充，语义相近但会连带悬停底，待设计确认",
      "--semi-white": "主按钮文字用 rgba(var(--semi-white),1)；深色模式下 Semi 该值非纯白，本期只做浅色",
      "--semi-color-nav-bg": "深蓝导航还需给导航容器加 .semi-always-dark 让文字变量跟着切换；七个 --ui-sidebar-* 由部门样式表直接覆盖 .semi-navigation",
      "unmapped": "字号、控件高度、间距、字体族在 Semi 里是构建期 Sass 变量（$font-size-regular 14px、$height-control-default 32px、$spacing-base 16px），运行时没有 CSS 变量：接受默认（控件 32／40）或用 semi-vite-plugin 在构建期覆盖（细项 D-3）"
    }
  },
  "antd": {
    "library": "antd 6.6.4（React ≥18）；备选",
    "outputs": {
      "json": {
        "file": "bridge-antd.theme.json",
        "platform": "web",
        "include": "<ConfigProvider theme={require('./bridge-antd.theme.json')}>；antd 会从 colorPrimary 自行派生十档"
      }
    },
    "map": {
      "token.colorPrimary": "{ui.primary}",
      "token.colorInfo": "{ui.primary}",
      "token.colorLink": "{ui.primary}",
      "token.colorSuccess": "{ui.success}",
      "token.colorWarning": "{ui.warning}",
      "token.colorError": "{ui.danger}",
      "token.colorText": "{ui.ink}",
      "token.colorTextSecondary": "{ui.secondary}",
      "token.colorTextTertiary": "{ui.muted}",
      "token.colorBgLayout": "{ui.background}",
      "token.colorBgContainer": "{ui.surface}",
      "token.colorBgElevated": "{ui.surface}",
      "token.colorBorder": "{ui.line}",
      "token.colorBorderSecondary": "{ui.line}",
      "token.colorPrimaryBg": "{ui.selected}",
      "token.borderRadius": "{ui.radius-control}",
      "token.borderRadiusLG": "{ui.radius-panel}",
      "token.controlHeight": "{ui.control-height}",
      "token.controlHeightLG": "{ui.field-height}",
      "token.fontSize": "{ui.text-body}",
      "token.fontSizeSM": "{ui.text-small}",
      "token.fontSizeLG": "{ui.text-section}",
      "token.fontSizeHeading3": "{ui.text-page}",
      "token.fontFamily": "{ui.font}",
      "token.boxShadowSecondary": "{ui.shadow-popup}",
      "cssVar.prefix": "ant"
    },
    "notes": {
      "token.controlHeight": "antd 默认 32；这里给 36 与 V-03 一致，antd 会按比例派生 SM／LG"
    }
  },
  "echarts": {
    "library": "echarts 6.x（Web；小程序 ec-canvas 同一份配置）。12 章：颜色、字号、网格线、坐标轴、悬停框全部从变量取，不写死",
    "outputs": {
      "json": {
        "file": "bridge-echarts.theme.json",
        "platform": "web",
        "include": "import theme from '@shandiant/tokens/bridge-echarts'; echarts.registerTheme('shandiant', theme); echarts.init(el, 'shandiant', { renderer: 'svg' })"
      }
    },
    "map": {
      "color.0": "{ui.chart-1}",
      "color.1": "{ui.chart-2}",
      "color.2": "{ui.chart-3}",
      "color.3": "{ui.chart-4}",
      "color.4": "{ui.chart-5}",
      "backgroundColor": "transparent",
      "textStyle.fontFamily": "{ui.font}",
      "textStyle.fontSize": "{ui.text-small}",
      "textStyle.color": "{ui.secondary}",
      "categoryAxis.axisLine.show": true,
      "categoryAxis.axisLine.lineStyle.color": "{ui.line}",
      "categoryAxis.axisTick.show": false,
      "categoryAxis.axisTick.lineStyle.color": "{ui.line}",
      "categoryAxis.axisLabel.color": "{ui.secondary}",
      "categoryAxis.axisLabel.fontSize": "{ui.text-small}",
      "categoryAxis.splitLine.show": false,
      "valueAxis.axisLine.show": false,
      "valueAxis.axisLine.lineStyle.color": "{ui.line}",
      "valueAxis.axisTick.show": false,
      "valueAxis.axisTick.lineStyle.color": "{ui.line}",
      "valueAxis.axisLabel.color": "{ui.secondary}",
      "valueAxis.axisLabel.fontSize": "{ui.text-small}",
      "valueAxis.splitLine.show": true,
      "valueAxis.splitLine.lineStyle.color": "{ui.line}",
      "valueAxis.splitLine.lineStyle.width": 1,
      "legend.left": "left",
      "legend.top": "top",
      "legend.itemWidth": "{ui.text-small}",
      "legend.itemHeight": "{ui.space-2}",
      "legend.textStyle.color": "{ui.secondary}",
      "legend.textStyle.fontSize": "{ui.text-small}",
      "tooltip.backgroundColor": "{ui.surface}",
      "tooltip.borderColor": "{ui.line}",
      "tooltip.borderWidth": 1,
      "tooltip.borderRadius": "{ui.radius-control}",
      "tooltip.padding": "{ui.space-3}",
      "tooltip.textStyle.color": "{ui.ink}",
      "tooltip.textStyle.fontSize": "{ui.text-body}",
      "tooltip.extraCssText": "box-shadow: {ui.shadow-popup};",
      "bar.barMaxWidth": 28,
      "bar.itemStyle.borderRadius": "{ui.space-1}",
      "line.lineStyle.width": 2,
      "line.symbolSize": 6,
      "line.smooth": false,
      "grid.left": "{ui.space-4}",
      "grid.right": "{ui.space-4}",
      "grid.top": "{ui.space-4}",
      "grid.bottom": "{ui.space-4}",
      "grid.containLabel": true
    },
    "notes": {
      "color.0": "顺序色五个（12 章 §3.4），第一个永远是主色；两个系列时组件取 chart-1 与 chart-5",
      "valueAxis.splitLine.show": "只画横线（12 章 §4）：竖向柱状与折线的横线来自数值轴；横向条形由组件把数值轴分割线关掉",
      "tooltip.extraCssText": "ECharts 的 tooltip 没有阴影变量，用 extraCssText 把 --ui-shadow-popup 写进去；圆角 6 来自 --ui-radius-control",
      "bar.barMaxWidth": "柱宽上限 28、柱圆角 4（--ui-space-1）；折线粗 2、点 6，都是 12 章第一版的建议值，尚无变量",
      "grid.left": "图区四周 --ui-space-4，containLabel 让轴标签算在边距内",
      "unmapped": "动画时长（首屏 300ms、切换不重放）与轴标签截断在组件里设，不进主题"
    }
  },
  "webawesome": {
    "library": "@awesome.me/webawesome 3.x（无框架路线 A 首选）",
    "outputs": {},
    "map": {},
    "notes": {
      "todo": "品牌色阶变量的准确名称（--wa-color-brand-*）在本会话无法读到官方主题文档，未能核实，本轮不生成；拿到官方 themes/default.css 后按同样写法补 map"
    }
  }
}
