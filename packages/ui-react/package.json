{
  "name": "@shandiant/ui-react",
  "version": "0.5.3",
  "description": "部门 Web 组件库：Ant Design 6 与 Ant Design X 之上的组合件与 AI 件，主题来自设计变量的桥接文件",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config catalog/vite.config.mjs",
    "build": "vite build --config catalog/vite.config.mjs && node catalog/postbuild.mjs",
    "build:lib": "vite build --config vite.lib.config.mjs",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "antd": "^6.1.1",
    "@ant-design/x": "^2.3.0",
    "@shandiant/tokens": ">=1.1.0-draft.1",
    "@ant-design/icons": "^6.0.0"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "antd": "6.6.4",
    "@ant-design/x": "2.9.0",
    "@ant-design/icons": "^6.0.0",
    "vite": "6.4.3",
    "@vitejs/plugin-react": "^4.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shandianT/desgin.git",
    "directory": "packages/ui-react"
  },
  "types": "./dist/index.d.ts"
}
