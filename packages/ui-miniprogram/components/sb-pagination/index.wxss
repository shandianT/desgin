.sb-pager { display: flex; justify-content: space-between; align-items: center; gap: var(--ui-space-3); padding: var(--ui-space-3) var(--ui-page-gutter); font-size: var(--ui-text-small); color: var(--ui-secondary); background: var(--ui-surface); }
.sb-pager-ctl { display: flex; align-items: center; gap: var(--ui-space-2); }
.sb-pager-pos { color: var(--ui-ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
.sb-pager-end { color: var(--ui-muted); }
