<view class="sb-lselect {{disabled ? 'disabled' : ''}} {{value !== null && value !== undefined && value !== '' ? 'on' : ''}}" bind:tap="onOpen" aria-role="button" aria-label="{{label}}：{{text}}">
  <text class="sb-lselect-label">{{label}}</text>
  <text class="sb-lselect-text">{{text}}</text>
  <view wx:if="{{allowClear && value !== null && value !== undefined && value !== '' && !disabled}}" class="sb-lselect-clear" catch:tap="onClear" aria-role="button" aria-label="清除"><t-icon name="close-circle-filled" size="32rpx" /></view>
  <t-icon wx:else name="chevron-down" size="32rpx" class="sb-lselect-arrow" />
</view>
<t-picker visible="{{open}}" title="{{label}}" value="{{pickerValue}}" cancel-btn="取消" confirm-btn="确定" bind:cancel="onCancel" bind:confirm="onConfirm">
  <t-picker-item options="{{columns}}" />
</t-picker>
