<view class="sb-seg {{size === 'small' ? 'small' : ''}}" aria-role="radiogroup">
  <view wx:for="{{options}}" wx:key="value" class="sb-seg-item {{item.value === value ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}" data-value="{{item.value}}" data-disabled="{{item.disabled}}" bind:tap="onTap" aria-role="radio" aria-checked="{{item.value === value}}" aria-disabled="{{item.disabled}}">{{item.label}}</view>
</view>
