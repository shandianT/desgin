.sb-kpi { display: flex; flex-direction: column; gap: var(--ui-space-1); min-width: 0; padding: var(--ui-card-padding); border: 1px solid var(--ui-line); border-radius: var(--ui-radius-panel); background: var(--ui-surface); }
.sb-kpi.compact { padding: var(--ui-space-3); }
.sb-kpi.compact .sb-kpi-label { font-size: 14px; }
.sb-kpi.compact .sb-kpi-value { font-size: 20px; font-weight: 700; }
.sb-kpi.compact .sb-kpi-value.missing { font-size: var(--ui-text-body); }
.sb-kpi.compact .sb-kpi-unit { font-size: var(--ui-text-small); }
.sb-kpi-hover { background: var(--ui-selected); }
.sb-kpi-label { font-size: var(--ui-text-body); color: var(--ui-secondary); }
.sb-kpi-row { display: flex; align-items: baseline; gap: var(--ui-space-1); min-width: 0; }
.sb-kpi-value { font-size: var(--ui-text-metric); font-weight: 650; line-height: 1.2; color: var(--ui-ink); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sb-kpi-value.missing { font-size: var(--ui-text-page); color: var(--ui-muted); }
.sb-kpi-value.loading { color: var(--ui-muted); }
.sb-kpi-unit { font-size: var(--ui-text-body); color: var(--ui-secondary); }
.sb-kpi-change, .sb-kpi-note { font-size: var(--ui-text-small); color: var(--ui-muted); }
.sb-kpi-change.tone-good { color: var(--ui-success); }
.sb-kpi-change.tone-bad { color: var(--ui-danger); }
