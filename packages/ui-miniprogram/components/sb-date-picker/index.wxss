.sb-dpick { display: flex; flex-direction: column; gap: var(--ui-space-2); padding: var(--ui-space-2) var(--ui-page-gutter); background: var(--ui-surface); }
.sb-dpick-row { display: flex; align-items: center; gap: var(--ui-space-2); min-height: var(--ui-field-height); }
.sb-dpick-label { flex: 0 0 auto; font-size: var(--ui-text-body); color: var(--ui-secondary); }
.sb-req { color: var(--ui-danger); }
.sb-dpick-value { flex: 1; text-align: right; font-size: var(--ui-text-body); color: var(--ui-ink); font-variant-numeric: tabular-nums; }
.sb-dpick-value.placeholder { color: var(--ui-muted); }
.sb-dpick.disabled .sb-dpick-value { color: var(--ui-muted); }
.sb-dpick-arrow { color: var(--ui-muted); display: inline-flex; }
.sb-dpick-chips { display: flex; gap: var(--ui-space-2); flex-wrap: wrap; }
.sb-chip { padding: 0 var(--ui-space-3); min-height: 56rpx; line-height: 56rpx; border: 1px solid var(--ui-line); border-radius: var(--ui-radius-control); font-size: var(--ui-text-small); color: var(--ui-secondary); background: var(--ui-surface); }
.sb-chip.on { border-color: var(--ui-primary); color: var(--ui-primary); font-weight: 600; }
