<slot wx:if="{{state === 'normal'}}"></slot>
<view wx:elif="{{state === 'loading' && skeleton}}" class="sb-state-skel"><t-skeleton theme="paragraph" animation="gradient" /></view>
<view wx:elif="{{state === 'loading'}}" class="sb-state" aria-role="status"><t-loading theme="circular" size="40rpx" text="{{title || '正在加载…'}}" /><text wx:if="{{description}}" class="sb-state-note">{{description}}</text></view>
<view wx:elif="{{state === 'empty'}}" class="sb-state"><view class="sb-state-title">{{title || '没有匹配的记录'}}</view><text class="sb-state-desc">{{description || '换一个条件试试，或清除全部条件。'}}</text><t-button wx:if="{{showClear}}" size="small" variant="outline" bind:tap="onClear">{{clearLabel}}</t-button></view>
<view wx:elif="{{state === 'error'}}" class="sb-state" aria-role="alert"><view class="sb-state-title">{{title || '加载失败'}}</view><text class="sb-state-desc">{{description || '网络或服务暂时不可用。'}}</text><t-button size="small" theme="primary" bind:tap="onRetry">{{retryLabel}}</t-button><text class="sb-state-note">重试不会清除已选条件</text></view>
<view wx:elif="{{state === 'forbidden'}}" class="sb-state"><view class="sb-state-title">{{title || '暂无查看权限'}}</view><text class="sb-state-desc">{{description || '不在你的授权范围内，或权限已变化。这里不显示对象信息。'}}</text></view>
