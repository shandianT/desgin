.sb-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--ui-space-2); padding: var(--ui-space-8) var(--ui-space-4); text-align: center; color: var(--ui-secondary); min-height: 200px; }
.sb-state-skel { padding: var(--ui-space-4); }
.sb-state-title { font-size: var(--ui-text-section); color: var(--ui-ink); font-weight: 600; }
.sb-state-desc { font-size: var(--ui-text-body); }
.sb-state-note { font-size: var(--ui-text-small); color: var(--ui-muted); }
