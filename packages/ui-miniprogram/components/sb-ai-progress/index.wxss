.sb-progress { display: flex; flex-direction: column; gap: var(--ui-space-2); padding: var(--ui-space-3) var(--ui-page-gutter); border: 1px solid var(--ui-line); border-radius: var(--ui-radius-panel); background: var(--ui-surface); }
.sb-progress-stages { display: flex; flex-direction: column; gap: var(--ui-space-1); font-size: var(--ui-text-body); }
.sb-progress-stage { color: var(--ui-muted); }
.sb-progress-stage.done { color: var(--ui-success); }
.sb-progress-stage.current { color: var(--ui-ink); font-weight: 600; }
.sb-progress-failed .sb-progress-stage.current { color: var(--ui-danger); }
.sb-progress-foot { display: flex; justify-content: space-between; align-items: center; gap: var(--ui-space-3); min-height: 32px; font-size: var(--ui-text-small); color: var(--ui-secondary); }
