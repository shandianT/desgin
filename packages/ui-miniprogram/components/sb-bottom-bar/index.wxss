.sb-bottombar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: var(--ui-space-2); padding: var(--ui-space-3) var(--ui-page-gutter); padding-bottom: calc(var(--ui-space-3) + env(safe-area-inset-bottom, 0px)); background: var(--ui-surface); border-top: 1px solid var(--ui-line); z-index: 10; }
.sb-bottombar-line { display: block; color: var(--ui-secondary); font-size: var(--ui-text-small); line-height: 1.5; }
.sb-bottombar-reason { color: var(--ui-warning); }
/* 两个按钮等分，只有主按钮时撑满（0.8.0 起；0.7.0 是主按钮靠右 120 宽） */
.sb-bottombar-row { display: flex; gap: var(--ui-space-3); }
.sb-bottombar-btn { flex: 1; min-width: 0; }
.sb-bottombar-inactive { opacity: .45; }
