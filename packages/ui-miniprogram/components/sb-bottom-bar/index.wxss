.sb-bottombar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: var(--ui-space-2); align-items: center; padding: var(--ui-space-3) var(--ui-page-gutter); padding-bottom: calc(var(--ui-space-3) + env(safe-area-inset-bottom, 0px)); background: var(--ui-surface); border-top: 1px solid var(--ui-line); z-index: 10; }
.sb-bottombar-reason { flex: 1; color: var(--ui-muted); font-size: var(--ui-text-small); }
.sb-bottombar-primary { margin-left: auto; min-width: 120px; }
