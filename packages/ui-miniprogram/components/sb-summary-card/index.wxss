.sb-summary { display: flex; flex-direction: column; gap: var(--ui-space-3); padding: var(--ui-card-padding); background: var(--ui-surface); border: 1px solid var(--ui-line); border-radius: var(--ui-radius-panel); }
.sb-summary.small .sb-summary-title { font-size: var(--ui-text-section); font-weight: 600; }
.sb-summary.small .sb-summary-value { font-size: 20px; }
.sb-summary-side { flex: none; }
.sb-summary-head { display: flex; align-items: flex-start; gap: var(--ui-space-3); }
.sb-summary-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--ui-space-1); }
/* 范围标签与右上切换只和标题同一行，副标题、说明占满整宽（0.8.0 早期版本放在同一行会把副标题挤窄） */
.sb-summary-titlerow { display: flex; align-items: flex-start; gap: var(--ui-space-2); }
.sb-summary-titlerow > .sb-summary-title { flex: 1; min-width: 0; }
.sb-summary-mark { flex: none; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: var(--ui-radius-control); background: var(--ui-selected); color: var(--ui-primary); font-size: var(--ui-text-body); font-weight: 600; }
.sb-summary-title { font-size: 20px; font-weight: 700; line-height: 1.35; color: var(--ui-ink); word-break: break-all; }
.sb-summary-sub { display: block; font-size: 14px; line-height: 1.5; color: var(--ui-secondary); }
.sb-summary-scope { flex: none; padding: 2px var(--ui-space-2); border-radius: 999px; background: var(--ui-neutral-soft); color: var(--ui-neutral); font-size: var(--ui-text-small); line-height: 20px; }
.sb-summary-tags { display: flex; flex-wrap: wrap; gap: var(--ui-space-2); }
.sb-summary-tag { padding: 0 var(--ui-space-2); border-radius: 4px; background: var(--ui-neutral-soft); color: var(--ui-neutral); font-size: var(--ui-text-small); line-height: 22px; }
/* 指标一行：留白分组，指标之间一条细竖线（14 章「一层一圈边」「数字大、说明小」） */
.sb-summary-metrics { display: flex; padding-top: var(--ui-space-3); border-top: 1px solid var(--ui-line); }
.sb-summary-metric { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; padding: 0 var(--ui-space-3); border-left: 1px solid var(--ui-line); }
.sb-summary-metric:first-child { padding-left: 0; border-left: 0; }
.sb-summary-value { font-size: var(--ui-text-page); font-weight: 700; line-height: 1.25; color: var(--ui-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-summary-value.is-missing { font-size: var(--ui-text-body); font-weight: 600; color: var(--ui-muted); line-height: 30px; }
.sb-summary-unit { margin-left: 2px; font-size: var(--ui-text-small); font-weight: 400; color: var(--ui-secondary); }
.sb-summary-label { font-size: var(--ui-text-small); line-height: 1.5; color: var(--ui-secondary); }
.sb-summary-progress { display: flex; align-items: center; gap: var(--ui-space-3); }
.sb-summary-track { flex: 1; height: 6px; border-radius: 999px; background: var(--ui-neutral-soft); overflow: hidden; }
.sb-summary-fill { height: 100%; border-radius: 999px; background: var(--ui-primary); }
