<view class="demo">
  <view class="h">页面标题 sb-page-header</view>
  <view class="sub">默认：标题、范围、主操作</view>
  <sb-page-header title="客户" scope="本人负责 · 24 家"><t-button size="small" theme="primary">记录拜访</t-button><t-button size="small" variant="outline">创建任务</t-button></sb-page-header>
  <view class="sub">只有标题</view>
  <sb-page-header title="我的" />

  <view class="h">图标 sb-icon</view>
  <view class="row"><sb-icon name="customer" size="sm" /><sb-icon name="customer" size="md" /><sb-icon name="customer" size="lg" /><sb-icon name="risk" tone="warning" size="md" /><sb-icon name="fail" tone="danger" size="md" /></view>
  <view class="row"><sb-icon name="customer" tile tone="primary" size="lg" label="客户" /><sb-icon name="opportunity" tile size="md" label="商机" /><sb-icon name="risk" tile tone="warning" size="md" label="风险" /><sb-icon name="ai" tile tone="primary" size="sm" label="AI" /></view>
  <view class="h">状态标签 sb-status-tag</view>
  <view class="row"><sb-status-tag tone="good" /><sb-status-tag tone="watch" /><sb-status-tag tone="bad" /><sb-status-tag tone="pending" /><sb-status-tag tone="unset" /><sb-status-tag tone="watch" reason="一周无跟进" showReason /></view>

  <view class="h">四态面板 sb-state-panel</view>
  <sb-state-panel state="loading" /><sb-state-panel state="loading" skeleton /><sb-state-panel state="empty" title="没有匹配的客户" description="当前筛选：有风险、本人负责。" showClear /><sb-state-panel state="error" /><sb-state-panel state="forbidden" />

  <view class="h">筛选栏 sb-filter-bar</view>
  <view class="sub">已选，可点选与清除</view>
  <sb-filter-bar title="客户列表" scope="本人负责" options="{{filterOpts}}" value="{{filter}}" resultCount="{{filter.length ? 6 : 24}}" resultLabel="家" bind:change="onFilter" />
  <view class="sub">禁用</view>
  <sb-filter-bar title="客户列表" scope="本人负责" options="{{filterOpts}}" value="{{['risk']}}" resultCount="{{6}}" resultLabel="家" disabled />

  <view class="h">搜索框 sb-search</view>
  <view class="sub">默认，可输入，回车触发搜索</view>
  <sb-search value="{{search}}" loading="{{searchLoading}}" bind:change="onSearch" bind:search="onSearchSubmit" bind:clear="onSearchClear" />
  <view class="sub">输入中</view>
  <sb-search value="华宸" />
  <view class="sub">加载中</view>
  <sb-search value="华宸" loading />
  <view class="sub">禁用</view>
  <sb-search disabled />

  <view class="h">列表行 sb-list-row</view>
  <sb-list-row wx:for="{{rows}}" wx:key="name" name="{{item.name}}" summary="{{item.summary}}" tone="{{item.tone}}" reason="{{item.reason}}" time="{{item.time}}" selected="{{index === 0}}" />
  <sb-list-row name="泰和银行数据中心" disabled disabledReason="不在你的授权范围内" />

  <view class="h">带标签下拉 sb-labeled-select</view>
  <view class="row"><sb-labeled-select label="象限" value="{{quad}}" options="{{quadOpts}}" bind:change="onQuad" /><sb-labeled-select label="计划" options="{{[{value:'y',label:'有 IT 计划'},{value:'n',label:'无'}]}}" /><sb-labeled-select label="金额" disabled /></view>
  <view class="h">指标条 sb-metric-strip</view>
  <sb-metric-strip items="{{metrics}}" periods="{{[{value:'year',label:'本年'},{value:'all',label:'历年'}]}}" period="{{period}}" caliber="确收按合同签署月，回款按到账月，缺失显示未登记" bind:periodchange="onPeriod" />
  <view class="note">加载中：不显示 0</view>
  <sb-metric-strip items="{{metrics}}" loading />
  <view class="h">带数量标签页 sb-tabs</view>
  <sb-tabs items="{{[{key:'todo',label:'待处理',count:18},{key:'done',label:'已完成',count:4},{key:'closed',label:'已结束',count:0,disabled:true},{key:'all',label:'全部',count:122}]}}" activeKey="{{tab}}" bind:change="onTab" />
  <view class="h">分页 sb-pagination</view>
  <view class="sub">分页，可点上一页下一页</view>
  <sb-pagination current="{{page}}" total="{{124}}" pageSize="{{20}}" bind:change="onPage" />
  <view class="sub">末页，下一页禁用</view>
  <sb-pagination current="{{7}}" total="{{124}}" pageSize="{{20}}" />
  <view class="sub">加载更多，可点</view>
  <sb-pagination mode="more" total="{{124}}" loading="{{moreLoading}}" end="{{moreEnd}}" bind:more="onMore" />
  <view class="sub">加载更多，加载中</view>
  <sb-pagination mode="more" total="{{124}}" loading />
  <view class="sub">加载更多，已到末尾</view>
  <sb-pagination mode="more" total="{{124}}" end />

  <view class="h">指标卡 sb-metric-tile</view>
  <view class="grid">
    <sb-metric-tile value="1,250,000" label="ACV（元）" note="本季度" />
    <sb-metric-tile value="{{null}}" label="回款（元）" note="缺失不显示 0" />
    <sb-metric-tile value="{{0}}" label="逾期任务" note="明确零值才显示 0" />
    <sb-metric-tile value="" label="确收（元）" missingText="未填写" />
  </view>

  <view class="h">表单项 sb-field</view>
  <view class="sub">默认</view>
  <sb-field label="客户名称"><t-input value="{{fieldName}}" borderless bind:change="onFieldName" /></sb-field>
  <view class="sub">必填，带说明</view>
  <sb-field label="下一步" required help="须含时间与目标"><t-input value="{{fieldNext}}" placeholder="10 月 8 日前发方案" borderless bind:change="onFieldNext" /></sb-field>
  <view class="sub">错误就地</view>
  <sb-field label="客户预算" required error="请填写客户预算，已保留其余输入"><t-input value="{{fieldBudget}}" status="error" borderless bind:change="onFieldBudget" /></sb-field>
  <view class="sub">只读</view>
  <sb-field label="拜访日期" readOnly value="2026-09-19" />
  <view class="sub">只读且未填</view>
  <sb-field label="合同编号" readOnly />
  <view class="sub">选择器触发器放在 slot 里</view>
  <sb-field label="季度"><t-cell title="{{quarter}}" arrow bordered="{{false}}" bind:click="openSheet" /></sb-field>

  <view class="h">底部弹层 sb-sheet</view>
  <view class="row"><t-button size="small" variant="outline" bind:tap="openSheet">打开底部弹层</t-button></view>
  <sb-sheet visible="{{sheet}}" title="选择季度" confirmLabel="应用" confirmLoading="{{sheetBusy}}" bind:close="closeSheet" bind:confirm="confirmSheet">
    <view wx:for="{{['第三季度', '第四季度', '全年']}}" wx:key="*this" class="sheet-row {{item === quarter ? 'on' : ''}}" data-value="{{item}}" bind:tap="pickQuarter">{{item}}</view>
    <text slot="footer" class="note">已选：{{quarter}}</text>
  </sb-sheet>

  <view class="h">AI 标识 sb-ai-badge</view>
  <view class="row"><sb-ai-badge state="generating" /><sb-ai-badge state="pending" /><sb-ai-badge state="confirmed" confirmedBy="王明 9 月 19 日 " /></view>

  <view class="h">待确认字段 sb-ai-field</view>
  <sb-ai-field label="联系人角色" required value="{{ai.value}}" aiValue="张总（CIO）" state="{{ai.state}}" bind:change="onAi" bind:confirm="onAiConfirm" bind:restore="onAiRestore" />
  <sb-ai-field label="客户预算" required value="{{aiLow.value}}" state="{{aiLow.state}}" confidence="low" candidates="{{['300 万', '320 万', '待确认']}}" bind:change="onAiLow" />
  <sb-ai-field label="下一步" required value="" state="ai" error="下一步必须含时间与目标" />

  <view class="h">AI 依据 sb-ai-sources</view>
  <view class="sub">折叠，点标题展开，点每条弹提示</view>
  <sb-ai-sources items="{{sources}}" bind:tap="onSource" />
  <view class="sub">默认展开</view>
  <sb-ai-sources items="{{sources}}" defaultExpanded bind:tap="onSource" />
  <view class="sub">没有依据</view>
  <sb-ai-sources items="{{[]}}" />

  <view class="h">生成过程 sb-ai-progress</view>
  <view class="sub">进行中，点取消变成已取消；下面的按钮重新开始</view>
  <view class="card"><sb-ai-progress stages="{{stages}}" current="{{1}}" status="{{gen}}" detail="12/16" bind:cancel="onGenCancel" /><t-button size="small" variant="outline" bind:tap="onGenRestart">重新开始</t-button></view>
  <view class="sub">已取消</view>
  <view class="card"><sb-ai-progress stages="{{stages}}" current="{{1}}" status="cancelled" /></view>
  <view class="sub">失败，点重试会跑一遍再完成</view>
  <view class="card"><sb-ai-progress stages="{{stages}}" current="{{genFailStep}}" status="{{genFail}}" bind:retry="onGenFailRetry" /></view>
  <view class="sub">完成</view>
  <view class="card"><sb-ai-progress stages="{{stages}}" current="{{3}}" status="done" /></view>

  <view class="h">分段切换 sb-segmented</view>
  <view class="row"><sb-segmented options="{{segOpts}}" value="{{seg}}" bind:change="onSeg" /><sb-segmented size="small" options="{{segOpts}}" value="{{seg}}" bind:change="onSeg" /></view>

  <view class="h">日期选择 sb-date-picker</view>
  <view class="sub">快捷片：今天、本周（周日）、本季（季末）；点一行打开滚轮</view>
  <sb-date-picker label="下次拜访" required value="{{date}}" bind:change="onDate" />
  <sb-date-picker label="签约日期" value="2026-09-30" disabled />

  <view class="h">表单单选 sb-select</view>
  <sb-select label="商机阶段" required value="{{stage}}" options="{{stageOpts}}" bind:change="onStage" />
  <sb-select label="行业" placeholder="请选择行业" options="{{[]}}" disabled />

  <view class="h">金额输入 sb-amount-input</view>
  <view class="sub">失焦千分位、聚焦纯数字，只收正数；当前值 {{amount === null ? '空' : amount}}</view>
  <sb-amount-input label="客户预算" required value="{{amount}}" bind:change="onAmount" />
  <sb-amount-input label="合同额" unit="元" precision="{{0}}" value="{{null}}" disabled />

  <view class="h">多行文本 sb-textarea</view>
  <sb-textarea label="拜访摘要" required value="{{summary}}" maxlength="{{200}}" placeholder="口述后由 AI 整理，这里只做人工修改" bind:change="onSummary" />

  <view class="h">指标卡 sb-kpi-card</view>
  <view class="grid">
    <sb-kpi-card label="年度合同额" value="{{1880}}" unit="万元" change="{{ { text: '比上季 +12%', tone: 'up', good: true } }}" bind:tap="onKpi" />
    <sb-kpi-card label="需关注" value="{{5}}" unit="家" change="{{ { text: '比上周 +2 家', tone: 'up', good: true } }}" />
    <sb-kpi-card label="客户" value="{{24}}" unit="家" change="{{ { text: '比上季 +2 家', tone: 'up' } }}" />
    <sb-kpi-card label="回款" value="{{null}}" unit="万元" note="财务还没登记" />
    <sb-kpi-card label="确收" value="{{138}}" unit="万元" loading />
  </view>

  <view class="h">作战地图 sb-battle-map</view>
  <view class="sub">点圆点弹名字；点底部数字放大该格；重叠的点聚成圆写数字；当前选中：{{mapSelected || '无'}}</view>
  <view class="card"><sb-battle-map points="{{mapPoints}}" zoom="{{mapZoom}}" selectedId="{{mapSelected}}" unrated="{{3}}" bind:pointtap="onPoint" bind:clustertap="onCluster" bind:zoomchange="onZoom" bind:unratedtap="onUnrated" /></view>
  <view class="sub">空态</view>
  <view class="card"><sb-battle-map points="{{[]}}" bind:emptyaction="onMapEmpty" /></view>
  <view class="sub">加载中</view>
  <view class="card"><sb-battle-map loading /></view>

  <view class="h">图表卡片壳 sb-chart-card</view>
  <view class="sub">图区放 ec-canvas，这里用一段文字代替；点 ⓘ 看口径</view>
  <view class="card">
    <sb-chart-card title="本季毛利够不够" scope="本人 · 第三季度" caliber="毛利按确收合同额减成本，未确收不计" summary="7 月 12 万、8 月 15 万、9 月 18 万">
      <view slot="legend">本期 ▮ 上期 ▯</view>
      <view class="chart-stub">这里放 ec-canvas</view>
    </sb-chart-card>
  </view>
  <view class="sub">空、失败、加载中</view>
  <view class="card"><sb-chart-card title="客户排名" state="empty" /></view>
  <view class="card"><sb-chart-card title="客户排名" state="{{chartState}}" bind:retry="onChartRetry" /></view>
  <view class="card"><sb-chart-card title="客户排名" state="loading" /></view>

  <view class="h">时间轴 sb-timeline</view>
  <view class="sub">默认：时间、标题、说明、记录人；圆点色由 tone 决定；第一条可点</view>
  <view class="card"><sb-timeline items="{{tlItems}}" pending="等待下一次跟进，下一步：10 月 8 日前发方案" bind:tap="onTimeline" /></view>
  <view class="sub">紧凑、倒序</view>
  <view class="card"><sb-timeline items="{{tlItems}}" size="compact" reverse /></view>
  <view class="sub">空与加载中</view>
  <view class="card"><sb-timeline items="{{[]}}" emptyText="还没有跟进记录，记一次拜访后这里会出现。" /><sb-timeline loading /></view>

  <view class="h">附件上传 sb-upload</view>
  <view class="sub">本地列表：限 pdf、jpg，单个 20MB，最多 3 个；超限就地说明。当前 {{files.length}} 个</view>
  <view class="card"><sb-upload accept=".pdf,.jpg,.png" maxSize="{{20}}" maxCount="{{3}}" multiple value="{{files}}" bind:change="onFiles" /></view>
  <view class="sub">上传中与失败</view>
  <view class="card"><sb-upload accept=".pdf,.jpg" maxSize="{{20}}" value="{{filesBusy}}" /></view>
  <view class="sub">禁用</view>
  <view class="card"><sb-upload accept=".pdf" disabled hint="归档后不能再改附件" value="{{files}}" /></view>

  <view class="h">结果页 sb-result</view>
  <view class="sub">成功：主按钮查看客户、次按钮再记一条，extra 放三个数字</view>
  <view class="card"><sb-result status="success" title="拜访已归档" description="Agent 正在按已确认事实重算象限与风险，几分钟后在客户详情里看。" primaryLabel="查看客户" secondaryLabel="再记一条" bind:primary="onResultPrimary" bind:secondary="onResultSecondary"><sb-metric-strip slot="extra" items="{{resultMetrics}}" /></sb-result></view>
  <view class="sub">失败、提示、警示</view>
  <view class="card"><sb-result status="error" title="归档失败" description="网络或服务暂时不可用，你的输入已保留。" primaryLabel="重试" secondaryLabel="存草稿" /></view>
  <view class="card"><sb-result status="info" title="草稿已保存" description="回到列表后可以从「我的草稿」继续。" primaryLabel="回到列表" /></view>
  <view class="card"><sb-result status="warning" title="还有 3 项必填未确认" description="下一步、客户预算、联系人角色。" primaryLabel="回去补充" /></view>

  <view class="h">页面摘要卡 sb-summary-card</view>
  <view class="sub">页面顶部白卡，替代深色横幅：标题、范围、指标一行（缺失写未登记）</view>
  <view class="card"><sb-summary-card title="我的待办" subtitle="每一项都可进入详情，追踪状态并反馈完成结果" scope="仅本人" metrics="{{summaryMetrics}}" /></view>
  <view class="sub">客户摘要：首字方块、状态标签；建档进度</view>
  <view class="card"><sb-summary-card mark="星河智能" title="星河智能制造（广州）有限公司" subtitle="制造业 · 商机客户 · 渠道销售-南区" meta="负责人 王新源 · 更新于 2026-09-23" tags="{{summaryTags}}" /></view>
  <view class="card"><sb-summary-card title="创建新客户" subtitle="手动填写或语音生成草案，创建后仅归属本人" progress="25" progressLabel="必填已完成 2／8" /></view>

  <view class="h">描述列表 sb-desc-list</view>
  <view class="sub">行式（t-cell）：可点的行带箭头；空值未填写、必填空值待补充</view>
  <view class="card"><sb-desc-list items="{{descRows}}" /></view>
  <view class="sub">两列式：拜访结构化信息</view>
  <view class="card"><sb-desc-list layout="grid" items="{{descGrid}}" /></view>

  <view class="h">区块卡片 sb-section</view>
  <view class="sub">标题、说明、右侧一个链接；卡里不再套带边框的小卡</view>
  <sb-section title="当前商机" description="4 个商机 · 在推 298 万" extraLabel="查看全部"><sb-desc-list items="{{descShort}}" /></sb-section>

  <view class="h">头像 sb-avatar</view>
  <view class="sub">取字：中文去姓取后两字，两字原样，英文取前两个字母；三档 48 / 64 / 80rpx</view>
  <view class="row"><sb-avatar name="王小明" size="sm" /><sb-avatar name="王小明" /><sb-avatar name="王小明" size="lg" /><sb-avatar name="李雷" tone="neutral" /><sb-avatar name="欧阳修文" tone="success" /><sb-avatar name="zhangjt" tone="warning" /><sb-avatar name="" tone="danger" /><sb-avatar name="周玮" shape="square" /></view>

  <view class="h">底部标签栏 sb-tab-bar</view>
  <view class="sub">默认五个 Tab；演示里不固定在底部，当前：{{tab5}}</view>
  <sb-tab-bar value="{{tab5}}" fixed="{{false}}" safeArea="{{false}}" bind:change="onTab5" />
  <view class="pad"></view>
</view>
<view class="sub">底部操作条：点「切换禁用」看禁用说原因</view><view class="card"><t-button size="small" variant="outline" bind:tap="onBarToggle">切换禁用</t-button></view>
<sb-bottom-bar primaryLabel="归档" secondaryLabel="存草稿" loading="{{submitting}}" loadingLabel="归档中…" bind:primary="onSubmit"  disabled="{{barDisabled}}" disabledReason="「下一步」还没填时间与目标" />
