{
  "name": "@shandiant/tokens",
  "version": "1.4.0-draft.1",
  "description": "部门设计变量：--ui-* 的 CSS、WXSS、JSON 产物，以及给 Ant Design、TDesign、Semi、ECharts 的主题桥接文件。由规范仓库 tokens.json 生成，勿手改",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "!dist/*.md",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./css": "./dist/design-tokens.css",
    "./wxss": "./dist/design-tokens.wxss",
    "./json": {
      "types": "./types/json.d.ts",
      "default": "./dist/design-tokens.json"
    },
    "./miniprogram-app": {
      "types": "./types/miniprogram-app.d.ts",
      "default": "./dist/miniprogram-app.tokens.json"
    },
    "./bridge-antd": {
      "types": "./types/bridge-antd.d.ts",
      "import": "./dist/bridge-antd.theme.mjs",
      "require": "./dist/bridge-antd.theme.cjs",
      "default": "./dist/bridge-antd.theme.json"
    },
    "./bridge-echarts": {
      "types": "./types/bridge-echarts.d.ts",
      "import": "./dist/bridge-echarts.theme.mjs",
      "require": "./dist/bridge-echarts.theme.cjs",
      "default": "./dist/bridge-echarts.theme.json"
    },
    "./bridge-echarts.json": {
      "types": "./types/bridge-echarts.d.ts",
      "default": "./dist/bridge-echarts.theme.json"
    },
    "./bridge-tdesign.css": "./dist/bridge-tdesign.css",
    "./bridge-tdesign.wxss": "./dist/bridge-tdesign.wxss",
    "./bridge-semi.css": "./dist/bridge-semi.css",
    "./package.json": "./package.json",
    "./bridge-antd.json": {
      "types": "./types/bridge-antd.d.ts",
      "default": "./dist/bridge-antd.theme.json"
    }
  },
  "scripts": {
    "sync": "node sync.mjs",
    "prepack": "node sync.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shandianT/desgin.git",
    "directory": "packages/tokens"
  },
  "peerDependencies": {
    "antd": ">=6"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    }
  }
}
