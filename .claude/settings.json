{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/design-guard.mjs" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "echo '提醒：本仓库是部门设计规范，改样式或页面前按 .claude/skills/design-spec/SKILL.md 做，改完跑 node tools/check.mjs'" }]
      }
    ]
  }
}
